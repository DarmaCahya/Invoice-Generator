Table users {
  id uuid [pk]
  name varchar(100) [not null]
  email varchar(255) [not null, unique]
  avatar_url text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table roles {
  id uuid [pk]
  name varchar(50) [not null, unique, note: 'owner | admin | member | viewer | custom']
  description text
  is_system boolean [default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table permissions {
  id uuid [pk]
  name varchar(100) [not null, unique, note: 'invoice:create, invoice:read, invoice:update, invoice:delete, customer:read, customer:write, workspace:manage']
  module varchar(50) [not null]
  description text
  created_at timestamp [not null]
}

Table role_permissions {
  role_id uuid [not null, ref: > roles.id]
  permission_id uuid [not null, ref: > permissions.id]

  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table workspaces {
  id uuid [pk]
  type varchar(20) [not null, note: 'personal | company']
  name varchar(150) [not null]
  slug varchar(150) [not null, unique]
  owner_id uuid [not null, ref: > users.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    owner_id
    type
  }
}

Table workspace_members {
  id uuid [pk]
  workspace_id uuid [not null, ref: > workspaces.id]
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    (workspace_id, user_id) [unique]
    user_id
    role_id
  }
}

Table workspace_invitations {
  id uuid [pk]
  workspace_id uuid [not null, ref: > workspaces.id]
  email varchar(255) [not null]
  role_id uuid [not null, ref: > roles.id]
  token varchar(255) [not null, unique]
  expires_at timestamp [not null]
  accepted_at timestamp
  created_at timestamp [not null]

  Indexes {
    workspace_id
    email
  }
}

Table customers {
  id uuid [pk]
  workspace_id uuid [not null, ref: > workspaces.id]
  name varchar(150) [not null]
  email varchar(255)
  phone varchar(50)
  address text
  tax_number varchar(100)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    workspace_id
    (workspace_id, email)
  }
}

Table products {
  id uuid [pk]
  workspace_id uuid [not null, ref: > workspaces.id]
  name varchar(150) [not null]
  description text
  price decimal(15,2) [not null]
  unit varchar(50)
  tax_rate decimal(5,2) [default: 0]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    workspace_id
  }
}

Table invoices {
  id uuid [pk]
  workspace_id uuid [not null, ref: > workspaces.id]
  customer_id uuid [not null, ref: > customers.id]

  invoice_number varchar(100) [not null]
  issue_date date [not null]
  due_date date
  status varchar(30) [not null, note: 'draft | sent | unpaid | partially_paid | paid | overdue | cancelled']

  subtotal decimal(15,2) [not null, default: 0]
  discount decimal(15,2) [not null, default: 0]
  tax decimal(15,2) [not null, default: 0]
  total decimal(15,2) [not null, default: 0]

  notes text
  terms text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    workspace_id
    customer_id
    (workspace_id, invoice_number) [unique]
    status
    due_date
  }
}

Table invoice_items {
  id uuid [pk]
  invoice_id uuid [not null, ref: > invoices.id]
  product_id uuid [ref: > products.id]

  description text [not null]
  quantity decimal(15,3) [not null]
  unit varchar(50)
  unit_price decimal(15,2) [not null]

  discount decimal(15,2) [not null, default: 0]
  tax_rate decimal(5,2) [not null, default: 0]

  subtotal decimal(15,2) [not null, default: 0]
  total decimal(15,2) [not null, default: 0]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    invoice_id
    product_id
  }
}

Table payments {
  id uuid [pk]
  invoice_id uuid [not null, ref: > invoices.id]

  amount decimal(15,2) [not null]
  payment_date date [not null]
  method varchar(50) [not null]
  reference_number varchar(100)
  notes text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    invoice_id
    payment_date
  }
}

Table payment_methods {
  id uuid [pk]
  workspace_id uuid [not null, ref: > workspaces.id]

  name varchar(100) [not null]
  bank_name varchar(100)
  account_name varchar(150)
  account_number varchar(100)

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    workspace_id
    is_active
  }
}

Table invoice_templates {
  id uuid [pk]
  workspace_id uuid [not null, ref: > workspaces.id]

  name varchar(100) [not null]
  template_type varchar(50) [not null]
  settings jsonb

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    workspace_id
  }
}